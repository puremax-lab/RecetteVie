{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.title'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <article class="col-lg-8 col-xl-7">
            <h1 class="fw-bold mb-4">{{ 'legal.title'|trans }}</h1>
            <div class="alert alert-light border mb-4">{{ 'legal.demo'|trans }}</div>

            {% for section in ['publisher', 'host', 'data', 'credits'] %}
                <section class="mb-4">
                    <h2 class="h5 fw-bold">{{ ('legal.' ~ section ~ '_title')|trans }}</h2>
                    <p class="text-body-secondary mb-0">{{ ('legal.' ~ section ~ '_text')|trans|nl2br }}</p>
                </section>
            {% endfor %}
        </article>
    </div>
{% endblock %}
