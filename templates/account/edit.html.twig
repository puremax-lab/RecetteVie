{% extends 'base.html.twig' %}

{% block title %}{{ 'account.edit_title'|trans }}{% endblock %}

{% block body %}
    <div class="auth-card">
        <h1 class="page-title h2 mb-4">{{ 'account.edit_title'|trans }}</h1>
        {{ form_start(form) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">{{ 'account.save'|trans }}</button>
                <a href="{{ path('app_account') }}" class="btn btn-link">{{ 'recipe.cancel'|trans }}</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
