{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.request_title'|trans }}{% endblock %}

{% block body %}
    <div class="auth-card">
        <h1 class="page-title h2 mb-1">{{ 'reset_password.request_title'|trans }}</h1>
        <p class="text-body-secondary mb-4">{{ 'reset_password.request_text'|trans }}</p>
        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <button class="btn btn-primary w-100 btn-lg mt-2">{{ 'reset_password.request_submit'|trans }}</button>
        {{ form_end(requestForm) }}
        <p class="text-center mt-4 mb-0"><a href="{{ path('app_login') }}"><i class="bi bi-arrow-left"></i> {{ 'login.submit'|trans }}</a></p>
    </div>
{% endblock %}
