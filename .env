# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put your own values (Mailtrap credentials, database password...) in .env.local.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Default: MySQL from WAMP / XAMPP / MAMP (user "root", no password).
# Override it in .env.local if your setup differs.
DATABASE_URL="mysql://root@127.0.0.1:3306/recettevie?serverVersion=9.1.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Emails are discarded by default. To receive them, put an SMTP DSN in .env.local,
# e.g. a free Mailtrap sandbox: smtp://USER:PASSWORD@sandbox.smtp.mailtrap.io:2525
MAILER_DSN=null://null
MAILER_FROM=noreply@recettevie.test
###< symfony/mailer ###

###> app ###
# true  = new members must click the link sent by email before publishing (needs a real MAILER_DSN)
# false = demo mode: new accounts are confirmed immediately, no email needed
EMAIL_VERIFICATION=false
###< app ###
