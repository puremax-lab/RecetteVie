{% extends 'base.html.twig' %}

{% block title %}{{ 'recipe.edit'|trans }} · {{ recipe.localizedTitle(app.request.locale) }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold text-center text-lg-start mb-4">{{ 'recipe.edit_title'|trans({'%title%': recipe.localizedTitle(app.request.locale)}) }}</h1>
            <div class="bg-white border rounded-4 shadow-sm p-4 p-md-5">
                {{ include('recipe/_form.html.twig', {cancel_url: path('app_recipe_show', {id: recipe.id, slug: recipe.slug})}) }}
            </div>
        </div>
    </div>
{% endblock %}
