{% set route = app.current_route %}
<nav class="navbar navbar-expand-lg bg-body border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand h4 mb-0 fw-bold" href="{{ path('home') }}">
            <i class="bi bi-book-half text-primary me-1"></i> RecetteVie
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="{{ 'nav.toggle'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link fw-medium {{ route == 'home' ? 'active' }}" {{ route == 'home' ? 'aria-current="page"' }} href="{{ path('home') }}">{{ 'nav.home'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium {{ route in ['app_recipe_index', 'app_recipe_show'] ? 'active' }}" href="{{ path('app_recipe_index') }}">{{ 'nav.recipes'|trans }}</a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                {% if app.user %}
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-3 {{ route == 'app_recipe_create' ? 'active' }}" href="{{ path('app_recipe_create') }}">
                            <i class="bi bi-plus-lg"></i> {{ 'nav.add_recipe'|trans }}
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="badge rounded-pill text-bg-primary">{{ app.user.firstname|first|upper }}</span>
                            {{ app.user.firstname }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_account') }}"><i class="bi bi-person me-2"></i>{{ 'nav.account'|trans }}</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ logout_path() }}" data-turbo="false"><i class="bi bi-box-arrow-right me-2"></i>{{ 'nav.logout'|trans }}</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link fw-medium {{ route == 'app_login' ? 'active' }}" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-3" href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
                    </li>
                {% endif %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-uppercase small fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'nav.language'|trans }}">
                        <i class="bi bi-translate"></i> {{ app.request.locale }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item {{ app.request.locale == 'fr' ? 'active' }}" href="{{ path('app_locale', {locale: 'fr'}) }}" lang="fr">Français</a></li>
                        <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' }}" href="{{ path('app_locale', {locale: 'en'}) }}" lang="en">English</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
