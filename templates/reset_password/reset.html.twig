{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.reset_title'|trans }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="bg-white border rounded-4 shadow-sm p-4 p-md-5">
                <h1 class="fw-bold h2 mb-4">{{ 'reset_password.reset_title'|trans }}</h1>
                {{ form_start(resetForm) }}
                    {{ form_row(resetForm.plainPassword) }}
                    <button class="btn btn-primary w-100 btn-lg mt-2">{{ 'reset_password.reset_submit'|trans }}</button>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </div>
{% endblock %}
