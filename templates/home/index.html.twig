{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block hero %}
    <section class="bg-primary-subtle border-bottom">
        <div class="container py-5">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-7 text-center text-lg-start">
                    <p class="text-uppercase small fw-semibold text-primary">{{ 'site.tagline'|trans }}</p>
                    <h1 class="display-4 fw-bold lh-1 mb-3">{{ 'home.hero_title'|trans }}</h1>
                    <p class="lead text-body-secondary mb-4">{{ 'home.hero_text'|trans }}</p>
                    <form action="{{ path('app_recipe_index') }}" method="get" class="col-lg-10" role="search">
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-body-secondary"></i></span>
                            <input type="search" name="q" class="form-control border-start-0" placeholder="{{ 'home.search_placeholder'|trans }}" aria-label="{{ 'home.search_button'|trans }}">
                            <button class="btn btn-primary" type="submit" aria-label="{{ 'home.search_button'|trans }}"><span class="d-none d-sm-inline">{{ 'home.search_button'|trans }}</span><i class="bi bi-arrow-right d-sm-none"></i></button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="row row-cols-2 g-3" aria-hidden="true">
                        {% for icon in ['🥗', '🍲', '🥖', '🍰'] %}
                            <div class="col">
                                <div class="ratio ratio-1x1 bg-white rounded-circle shadow-sm border">
                                    <span class="d-flex align-items-center justify-content-center display-3">{{ icon }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block body %}
    <section class="mb-5">
        <h2 class="fs-3 fw-bold mb-4 text-center text-md-start">{{ 'home.categories'|trans }}</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
            {% for row in categories %}
                <div class="col">
                    <a href="{{ path('app_recipe_index', {categorie: row.category.slug}) }}" class="card h-100 text-center text-decoration-none border-0 shadow-sm">
                        <span class="card-body d-flex flex-column align-items-center gap-1 py-4">
                            <span class="display-6">{{ row.category.icon }}</span>
                            <span class="fw-semibold text-body">{{ row.category|category_name }}</span>
                            <span class="small text-body-secondary">{{ 'home.recipe_count'|trans({'%count%': row.recipeCount}) }}</span>
                        </span>
                    </a>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="mb-5">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center align-items-sm-end gap-1 mb-4">
            <h2 class="fs-3 fw-bold text-center text-sm-start mb-0">{{ 'home.latest'|trans }}</h2>
            <a href="{{ path('app_recipe_index') }}" class="link-primary fw-semibold text-decoration-none">{{ 'home.see_all'|trans }} <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            {% for recipe in latestRecipes %}
                <div class="col">{{ include('recipe/_card.html.twig') }}</div>
            {% endfor %}
        </div>
    </section>

    <section class="bg-primary-subtle border border-primary-subtle rounded-4 p-4 p-lg-5 text-center">
        <h2 class="h3">{{ 'home.cta_title'|trans }}</h2>
        <p class="text-body-secondary mb-4">{{ 'home.cta_text'|trans }}</p>
        <div class="d-grid d-sm-block">
            <a href="{{ path(app.user ? 'app_recipe_create' : 'app_register') }}" class="btn btn-primary btn-lg">{{ 'home.cta_button'|trans }}</a>
        </div>
    </section>
{% endblock %}
