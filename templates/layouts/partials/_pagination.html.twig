{# Expects: page (App\Pagination\Page), route, params #}
{% if page.lastPage > 1 %}
    <nav aria-label="{{ 'pagination.label'|trans }}" class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item {{ not page.hasPrevious ? 'disabled' }}">
                <a class="page-link" href="{{ path(route, params|merge({page: page.current - 1})) }}">
                    <i class="bi bi-chevron-left"></i> <span class="d-none d-sm-inline">{{ 'pagination.previous'|trans }}</span>
                </a>
            </li>
            {% for i in 1..page.lastPage %}
                <li class="page-item {{ i == page.current ? 'active' }}" {{ i == page.current ? 'aria-current="page"' }}>
                    <a class="page-link" href="{{ path(route, params|merge({page: i})) }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {{ not page.hasNext ? 'disabled' }}">
                <a class="page-link" href="{{ path(route, params|merge({page: page.current + 1})) }}">
                    <span class="d-none d-sm-inline">{{ 'pagination.next'|trans }}</span> <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
