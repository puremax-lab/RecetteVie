{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.check_email_title'|trans }}{% endblock %}

{% block body %}
    <div class="auth-card text-center">
        <div class="display-4 mb-3">📬</div>
        <h1 class="page-title h2">{{ 'reset_password.check_email_title'|trans }}</h1>
        <p class="text-body-secondary">
            {{ 'reset_password.check_email_text'|trans({'%expires%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
        </p>
        <p class="small mb-0">{{ 'reset_password.check_email_retry'|trans({'%url%': path('app_forgot_password_request')})|raw }}</p>
    </div>
{% endblock %}
