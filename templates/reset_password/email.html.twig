{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <p>{{ 'email.reset.text'|trans }}</p>
    <p style="margin:28px 0;">
        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="background:#c2410c;color:#ffffff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:bold;">{{ 'email.reset.button'|trans }}</a>
    </p>
    <p style="color:#7a6e66;font-size:13px;">{{ 'email.reset.expires'|trans({'%expires%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
{% endblock %}
