{# Expects: form, recipe (optional), cancel_url #}
{% macro counted(field, min, max) %}
    {# Live character counter (assets/controllers/char_counter_controller.js) #}
    {{ form_row(field, {attr: field.vars.attr|merge({
        'data-controller': 'char-counter',
        'data-char-counter-min-value': min,
        'data-char-counter-max-value': max,
        'data-char-counter-label-value': 'recipe_form.char_count'|trans,
        'data-char-counter-min-label-value': 'recipe_form.char_min'|trans({'%min%': min}),
    })}) }}
{% endmacro %}

{% set translate_attr = form.vars.auto_translation ? {
    'data-controller': 'translate',
    'data-translate-url-value': path('app_recipe_translate'),
    'data-translate-token-value': csrf_token('recipe-translate'),
    'data-translate-loading-value': 'translate.loading'|trans,
    'data-translate-done-value': 'translate.done'|trans,
    'data-translate-incomplete-value': 'translate.error_empty'|trans,
    'data-translate-failed-value': 'translate.error_unavailable'|trans,
} : {} %}
{{ form_start(form, {attr: translate_attr}) }}
    {{ form_errors(form) }}

    <div class="row g-3 mb-4">
        <div class="col-md-7">{{ form_row(form.category) }}</div>
        <div class="col-md-5">{{ form_row(form.duration) }}</div>
    </div>

    <div class="translation-intro mb-3">
        <i class="bi bi-translate"></i>
        <div>
            <strong>{{ 'recipe_form.languages_title'|trans }}</strong><br>
            {{ (form.vars.auto_translation ? 'recipe_form.languages_auto' : 'recipe_form.languages_manual')|trans }}
        </div>
    </div>

    <div class="row g-4">
        {% for locale, suffix in {fr: '', en: 'En'} %}
            <div class="col-lg-6">
                <fieldset class="language-box h-100" lang="{{ locale }}">
                    <legend>
                        {{ ('recipe_form.language_' ~ locale)|trans }}
                        {% if recipe is defined and recipe.machineTranslated(locale) %}
                            <span class="badge machine-badge">{{ 'recipe_form.machine_badge'|trans }}</span>
                        {% endif %}
                    </legend>
                    {{ _self.counted(form['title' ~ suffix], 3, 80) }}
                    {{ form_row(form['ingredients' ~ suffix]) }}
                    {{ _self.counted(form['content' ~ suffix], 20, 0) }}
                    {% if form.vars.auto_translation %}
                        {% set other = locale == 'fr' ? 'en' : 'fr' %}
                        <button type="button" class="btn btn-outline-primary btn-sm mb-3"
                                data-action="translate#run"
                                data-translate-source-param="{{ locale }}"
                                data-translate-target-param="{{ other }}">
                            <i class="bi bi-translate"></i> {{ ('translate.button_' ~ other)|trans }}
                        </button>
                        <div class="translate-status small" data-translate-target="status" aria-live="polite"></div>
                    {% endif %}
                </fieldset>
            </div>
        {% endfor %}
    </div>

    <div class="mt-4">
        {% if recipe is defined and recipe.imageName %}
            <p class="small text-body-secondary mb-1">{{ 'recipe.current_photo'|trans }}</p>
            <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="" class="rounded-3 mb-3 object-fit-cover" width="160" height="110">
        {% endif %}
        {{ form_row(form.imageFile) }}
    </div>

    <div class="d-grid d-sm-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-lg"></i> {{ 'recipe.save'|trans }}</button>
        <a href="{{ cancel_url }}" class="btn btn-link btn-lg">{{ 'recipe.cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
