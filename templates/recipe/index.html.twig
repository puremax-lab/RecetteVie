{% extends 'base.html.twig' %}

{% block title %}{{ currentCategory ? currentCategory|category_name : 'recipe.list_title'|trans }}{% endblock %}

{% block body %}
    {% set params = {q: query, categorie: currentCategory ? currentCategory.slug : null}|filter(v => v) %}

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">{{ currentCategory ? currentCategory.icon ~ ' ' ~ currentCategory|category_name : 'recipe.list_title'|trans }}</h1>
            <p class="text-body-secondary mb-0">
                {{ 'recipe.results'|trans({'%count%': recipes.totalItems}) }}
                {% if query %}{{ 'recipe.results_for'|trans({'%query%': query}) }}{% endif %}
            </p>
        </div>
        <form method="get" class="search-bar search-bar-sm d-flex" role="search">
            <i class="bi bi-search"></i>
            {% if currentCategory %}<input type="hidden" name="categorie" value="{{ currentCategory.slug }}">{% endif %}
            <input type="search" name="q" value="{{ query }}" class="form-control" placeholder="{{ 'home.search_placeholder'|trans }}" aria-label="{{ 'home.search_button'|trans }}">
            <button class="btn btn-primary" type="submit">{{ 'home.search_button'|trans }}</button>
        </form>
    </div>

    <div class="chips mb-4">
        <a href="{{ path('app_recipe_index', query ? {q: query} : {}) }}" class="chip {{ not currentCategory ? 'active' }}">{{ 'recipe.all_categories'|trans }}</a>
        {% for row in categories %}
            <a href="{{ path('app_recipe_index', {categorie: row.category.slug}|merge(query ? {q: query} : {})) }}" class="chip {{ currentCategory and currentCategory.id == row.category.id ? 'active' }}">
                {{ row.category.icon }} {{ row.category|category_name }} <span class="chip-count">{{ row.recipeCount }}</span>
            </a>
        {% endfor %}
    </div>

    {% if recipes.totalItems > 0 %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            {% for recipe in recipes %}
                <div class="col">{{ include('recipe/_card.html.twig') }}</div>
            {% endfor %}
        </div>
        {{ include('layouts/partials/_pagination.html.twig', {page: recipes, route: 'app_recipe_index', params: params}) }}
    {% else %}
        <div class="empty-state text-center py-5">
            <div class="display-4 mb-3">🔍</div>
            <h2 class="h4">{{ 'recipe.empty_title'|trans }}</h2>
            <p class="text-body-secondary">{{ 'recipe.empty_text'|trans }}</p>
            <a href="{{ path('app_recipe_index') }}" class="btn btn-outline-primary">{{ 'recipe.clear_filters'|trans }}</a>
        </div>
    {% endif %}
{% endblock %}
