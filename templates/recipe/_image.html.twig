{# The recipe photo, or a soft placeholder with the category emoji. Expects: recipe, class #}
{% if recipe.imageName %}
    <img src="{{ asset('uploads/recipes/' ~ recipe.imageName) }}" alt="{{ recipe.localizedTitle(app.request.locale) }}" class="{{ class }} object-fit-cover" loading="lazy">
{% else %}
    <div class="{{ class }} d-flex align-items-center justify-content-center bg-primary-subtle" role="img" aria-label="{{ recipe.localizedTitle(app.request.locale) }}">
        <span class="display-1">{{ recipe.category.icon }}</span>
    </div>
{% endif %}
