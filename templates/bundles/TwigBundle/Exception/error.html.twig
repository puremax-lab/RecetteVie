{% extends 'base.html.twig' %}

{% set kind = status_code == 404 ? 'not_found' : (status_code == 403 ? 'forbidden' : 'generic') %}

{% block title %}{{ ('error.' ~ kind ~ '_title')|trans }}{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <div class="error-code">{{ status_code }}</div>
        <h1 class="page-title h2">{{ ('error.' ~ kind ~ '_title')|trans }}</h1>
        <p class="text-body-secondary mb-4">{{ ('error.' ~ kind ~ '_text')|trans }}</p>
        <a href="{{ path('home') }}" class="btn btn-primary">{{ 'error.back_home'|trans }}</a>
    </div>
{% endblock %}
