# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Tests run on an SQLite file so they need no MySQL server.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
MAILER_DSN=null://null
EMAIL_VERIFICATION=true
# Test-only key pair, created by tests/bootstrap.php in config/jwt/test (not committed).
JWT_PASSPHRASE=test-only-passphrase
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
