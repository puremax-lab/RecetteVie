{% extends 'base.html.twig' %}

{% block title %}{{ recipe.localizedTitle(app.request.locale) }}{% endblock %}
{% block meta_description %}{{ recipe.localizedSteps(app.request.locale)|first|u.truncate(155, '…') }}{% endblock %}

{% block body %}
    {% set title = recipe.localizedTitle(app.request.locale) %}
    {% set ingredients = recipe.localizedIngredientList(app.request.locale) %}
    {% set steps = recipe.localizedSteps(app.request.locale) %}

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small justify-content-center justify-content-lg-start">
            <li class="breadcrumb-item"><a class="text-decoration-none" href="{{ path('app_recipe_index') }}">{{ 'nav.recipes'|trans }}</a></li>
            <li class="breadcrumb-item"><a class="text-decoration-none" href="{{ path('app_recipe_index', {categorie: recipe.category.slug}) }}">{{ recipe.category|category_name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
        </ol>
    </nav>

    <article>
        <div class="row g-4 g-lg-5 align-items-center mb-5">
            <div class="col-lg-6">
                <div class="ratio ratio-4x3 rounded-4 overflow-hidden shadow-sm">
                    {{ include('recipe/_image.html.twig', {class: 'w-100'}) }}
                </div>
            </div>
            <div class="col-lg-6 text-center text-lg-start">
                <span class="badge bg-primary-subtle text-primary-emphasis fw-medium mb-3">{{ recipe.category.icon }} {{ recipe.category|category_name }}</span>
                <h1 class="display-5 fw-bold">{{ title }}</h1>
                <div class="row row-cols-3 g-3 my-3 text-center">
                    <div class="col"><div class="bg-white border rounded-3 py-3"><i class="bi bi-clock fs-4 text-primary"></i><span class="small text-body-secondary d-block">{{ 'recipe.duration'|trans }}</span><strong>{{ recipe.duration|duration }}</strong></div></div>
                    <div class="col"><div class="bg-white border rounded-3 py-3"><i class="bi bi-basket fs-4 text-primary"></i><span class="small text-body-secondary d-block">{{ 'recipe.ingredients'|trans }}</span><strong>{{ ingredients|length }}</strong></div></div>
                    <div class="col"><div class="bg-white border rounded-3 py-3"><i class="bi bi-list-ol fs-4 text-primary"></i><span class="small text-body-secondary d-block">{{ 'recipe.steps'|trans }}</span><strong>{{ steps|length }}</strong></div></div>
                </div>
                <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-2 text-body-secondary">
                    <span class="badge rounded-pill text-bg-primary">{{ recipe.user.firstname|first|upper }}</span>
                    <span>
                        {{ 'recipe.by'|trans({'%author%': recipe.user.fullName}) }} · {{ 'recipe.published'|trans({'%ago%': recipe.createdAt|ago}) }}
                        {% if recipe.updatedAt > recipe.createdAt %}<br><small>{{ 'recipe.updated_on'|trans({'%date%': recipe.updatedAt|format_date('long')}) }}</small>{% endif %}
                    </span>
                </div>

                {% if is_granted('RECIPE_EDIT', recipe) %}
                    <div class="d-grid d-sm-flex justify-content-sm-center justify-content-lg-start gap-2 mt-4">
                        <a class="btn btn-outline-primary" href="{{ path('app_recipe_edit', {id: recipe.id}) }}"><i class="bi bi-pencil"></i> {{ 'recipe.edit'|trans }}</a>
                        <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" class="d-grid" data-turbo-confirm="{{ 'recipe.delete_confirm'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-recipe-' ~ recipe.id) }}">
                            <button class="btn btn-outline-danger"><i class="bi bi-trash"></i> {{ 'recipe.delete'|trans }}</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">{{ 'recipe.ingredients'|trans }}</h2>
                        <ul class="list-group list-group-flush">
                            {% for ingredient in ingredients %}
                                <li class="list-group-item px-0 d-flex gap-2"><i class="bi bi-dot text-primary"></i>{{ ingredient }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <h2 class="h4 mb-3">{{ 'recipe.steps'|trans }}</h2>
                {% if recipe.machineTranslated(app.request.locale) %}
                    <p class="small text-body-secondary"><i class="bi bi-translate me-1"></i>{{ 'recipe.machine_translated'|trans }}</p>
                {% endif %}
                <ol class="list-unstyled">
                    {% for step in steps %}
                        <li class="d-flex gap-3 mb-4">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fs-6 align-self-start">{{ loop.index }}</span>
                            <span class="lh-lg">{{ step }}</span>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    </article>

    {% if similarRecipes is not empty %}
        <section class="mt-5 pt-4 border-top">
            <h2 class="fs-3 fw-bold mb-4 text-center text-md-start">{{ 'recipe.similar'|trans }}</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                {% for recipe in similarRecipes %}
                    <div class="col">{{ include('recipe/_card.html.twig') }}</div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <a href="{{ path('app_recipe_index') }}" class="btn btn-link px-0 mt-4"><i class="bi bi-arrow-left"></i> {{ 'recipe.back'|trans }}</a>
{% endblock %}
